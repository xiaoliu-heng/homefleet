# LAN IP or DNS name only (no scheme/port/path).
HOMEFLEET_HOST=192.168.1.10
# Replace before first startup; change existing password using hub --reset-password.
HOMEFLEET_ADMIN_PASSWORD=
# Optional non-default port or additional browser origin (exact HTTPS URLs, comma separated).
# HOMEFLEET_BIND_IP=192.168.1.10
# HOMEFLEET_HTTPS_PORT=8443
# HOMEFLEET_PUBLIC_URL=https://192.168.1.10:8443
# HOMEFLEET_ALLOWED_ORIGINS=https://100.64.0.10:8443
# Additional addresses also need a matching Caddy site/certificate and port binding.
# These HTTPS origins also appear in the enrollment address picker.
# Existing Traefik with a publicly trusted wildcard certificate:
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml
# HOMEFLEET_DOMAIN=homefleet.example.com
# HOMEFLEET_PROXY_NETWORK=proxy
# Include compose.override.yaml in COMPOSE_FILE if using a host-specific override.
